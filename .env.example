# Copy to .env and fill in. Do not commit the real .env file.

# PostgreSQL database from task2_databases/sql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airquality

# MongoDB database from task2_databases/mongodb. Leave unset to run the API
# against the in-memory mongomock emulator instead.
MONGO_URI=
MONGO_DB_NAME=airquality
MONGO_COLLECTION_NAME=readings
